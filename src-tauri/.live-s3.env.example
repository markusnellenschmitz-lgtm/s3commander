# Zugangsdaten für die Live-Tests (src-tauri/tests/live_s3.rs).
# Kopieren nach .live-s3.env und ausfüllen. .live-s3.env niemals einchecken oder teilen.
# Hetzner: Endpoint https://<region>.your-objectstorage.com, Regionen fsn1, nbg1, hel1.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=mein-test-bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: path-style statt virtual-hosted
# S3_ADDRESSING=path-style
