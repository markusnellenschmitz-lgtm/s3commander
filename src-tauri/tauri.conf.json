{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "S3 Commander",
  "version": "0.3.0",
  "identifier": "app.s3commander",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "S3 Commander",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#1b1b1c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "S3 Commander",
    "shortDescription": "Desktop-Client für S3-kompatiblen Object Storage",
    "longDescription": "Schneller Desktop-Client für Amazon S3 und S3-kompatiblen Object Storage (MinIO, Cloudflare R2, Backblaze B2, Wasabi, Hetzner, Ceph, Garage): Tabs, Zwei-Panel-Ansicht, Drag and Drop, parallele Transfers und eine Objektliste für Millionen Einträge.",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
